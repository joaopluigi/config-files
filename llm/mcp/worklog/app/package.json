{
  "name": "worklog-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "../electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron": "electron ../electron/main.mjs",
    "dist:electron": "npm run build && electron-builder --config \"$PWD/electron-builder.yml\" --projectDir \"$PWD/..\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "tailwindcss": "^4.3.3",
    "vitest": "latest"
  }
}
