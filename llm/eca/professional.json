{
  "defaultAgent": "orchestrator",
  "defaultModel": "anthropic/claude-opus-5-5",
  "providers": {
    "openai": {
      "api": "openai-responses",
      "url": "${cmd:nu genai ai-gateway url}",
      "key": "${cmd:nu genai ai-gateway token}",
      "fetchModels": false,
      "models": {
        "gpt-5.6-luna": {}
      }
    },
    "anthropic": {
      "api": "anthropic",
      "url": "${cmd:nu genai ai-gateway url}",
      "key": "${cmd:nu genai ai-gateway token}",
      "fetchModels": false,
      "models": {
        "claude-opus-5-5": {}
      }
    }
  },
  "disabledTools": [
    "slack__.*add.*",
    "google-workspace__docs_(create|write|replace|format).*",
    "google-workspace__drive_(create|move|trash|rename).*",
    "google-workspace__calendar_(create|update|respond|delete).*",
    "google-workspace__chat_(send|setUp).*",
    "google-workspace__gmail_(modify|batchModify|send|create).*",
    "atlassian__(create|update|edit|add|transition).*"
  ],
  "toolCall": {
    "approval": {
      "byDefault": "allow",
      "ask": {
        "shell_command": {
          "argsMatchers": {
            "command": [
              ".*\\brm\\b.*",
              ".*\\bmv\\b.*"
            ]
          }
        }
      }
    }
  },
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "google-workspace": {
      "command": "node",
      "args": [
        "$HOME/dev/workspace/workspace-server/dist/index.js"
      ],
      "env": {}
    },
    "slack": {
      "command": "$HOME/dev/slack-mcp-server/start.sh"
    },
    "worklog": {
      "command": "node",
      "args": [
        "$HOME/dev/config-files/llm/mcp/worklog/server.mjs"
      ],
      "env": {}
    }
  }
}
