{
  "defaultModel": "openai/gpt-5.6-luna",
  "providers": {
    "openai": {
      "api": "openai-responses",
      "urlEnv": "OPENAI_API_URL",
      "keyEnv": "OPENAI_API_KEY",
      "fetchModels": false,
      "models": {
        "gpt-5.3-codex": {
          "extraPayload": {
            "reasoning": {
              "effort": "none"
            }
          },
          "cost": {
            "input": 1.75,
            "output": 14,
            "cacheRead": 0.18
          }
        },
        "gpt-5.6-luna": {}
      }
    },
    "anthropic": {
      "api": "anthropic",
      "urlEnv": "ANTHROPIC_API_URL",
      "keyEnv": "ANTHROPIC_API_KEY",
      "fetchModels": false,
      "models": {
        "haiku-4.5": {
          "modelName": "claude-haiku-4-5"
        },
        "sonnet-4.6": {
          "modelName": "claude-sonnet-4-6"
        },
        "sonnet-5": {
          "modelName": "claude-sonnet-5"
        },
        "opus-4.8": {
          "modelName": "claude-opus-4-8",
          "extraPayload": {
            "thinking": {
              "type": "adaptive"
            }
          }
        }
      }
    }
  },
  "agent": {
    "code": {
      "variant": "high"
    }
  },
  "disabledTools": [
    "slack__.*add.*",
    "google-workspace__docs_(create|write|replace|format).*",
    "google-workspace__drive_(create|move|trash|rename).*",
    "google-workspace__calendar_(create|update|respond|delete).*",
    "google-workspace__chat_(send|setUp).*",
    "google-workspace__gmail_(modify|batchModify|send|create).*",
    "atlassian__(create|update|edit|add|transition).*"
  ],
  "toolCall": {
    "approval": {
      "byDefault": "allow",
      "ask": {
        "shell_command": {
          "argsMatchers": {
            "command": [
              ".*\\brm\\b.*",
              ".*\\bmv\\b.*"
            ]
          }
        }
      }
    }
  },
  "mcpServers": {
    "atlassian": {
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "google-workspace": {
      "command": "node",
      "args": [
        "$HOME/dev/workspace/workspace-server/dist/index.js"
      ],
      "env": {}
    },
    "slack": {
      "command": "$HOME/dev/slack-mcp-server/start.sh"
    }
  }
}
