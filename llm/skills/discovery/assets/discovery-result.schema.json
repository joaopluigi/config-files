{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "discovery-result.schema.json",
  "title": "Discovery result",
  "type": "object",
  "required": ["laneMatrix", "sources", "priorArt", "contradictions", "gaps", "uncertainty", "stopStatus"],
  "properties": {
    "laneMatrix": {
      "type": "object",
      "required": [
        "local project files and history",
        "related organization projects",
        "official documentation and standards",
        "issues, pull requests, and discussions",
        "public prior art and packages",
        "domain references"
      ],
      "properties": {
        "local project files and history": { "$ref": "#/$defs/lane" },
        "related organization projects": { "$ref": "#/$defs/lane" },
        "official documentation and standards": { "$ref": "#/$defs/lane" },
        "issues, pull requests, and discussions": { "$ref": "#/$defs/lane" },
        "public prior art and packages": { "$ref": "#/$defs/lane" },
        "domain references": { "$ref": "#/$defs/lane" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provenance", "type", "claims"],
        "properties": {
          "provenance": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "priorArt": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate", "provenance", "decision", "evidence", "searchScope", "reason", "gaps", "uncertainty"],
        "properties": {
          "candidate": { "type": "string", "minLength": 1 },
          "provenance": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["reuse", "adapt", "reject", "none found"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "searchScope": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "contradictions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "uncertainty": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stopStatus": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["stopped", "continue"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "lane": {
      "type": "object",
      "required": ["status", "sources", "reason"],
      "properties": {
        "status": { "enum": ["searched", "not applicable", "inaccessible"] },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
